<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_diwali_night">

    <!-- Central Festive Content Box -->
    <LinearLayout
        android:id="@+id/llSplashContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Rocket Visual Container -->
        <FrameLayout
            android:id="@+id/flRocketContainer"
            android:layout_width="@dimen/_110sdp"
            android:layout_height="@dimen/_150sdp">

            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/composeSplashRocket"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <!-- Shiny App Title -->
        <TextView
            android:id="@+id/tvSplashTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_16sdp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.08"
            android:text="DHAMAKA"
            android:textColor="@color/gold_yellow"
            android:textSize="@dimen/_32ssp"
            android:textStyle="bold" />

        <!-- Subtitle Badge -->
        <TextView
            android:id="@+id/tvSplashSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_6sdp"
            android:background="@drawable/bg_pill_dark"
            android:paddingStart="@dimen/_14sdp"
            android:paddingTop="@dimen/_4sdp"
            android:paddingEnd="@dimen/_14sdp"
            android:paddingBottom="@dimen/_4sdp"
            android:text="3D Fireworks Arcade"
            android:textColor="@color/gold_light"
            android:textSize="@dimen/_12ssp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom Festival Greeting -->
    <TextView
        android:id="@+id/tvSplashFooter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_24sdp"
        android:letterSpacing="0.05"
        android:text="FESTIVAL OF LIGHTS"
        android:textColor="#80FFD54F"
        android:textSize="@dimen/_10ssp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
