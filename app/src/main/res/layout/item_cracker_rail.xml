<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/llRailItemRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/_8sdp"
    android:background="@drawable/bg_pill_dark"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="@dimen/_4sdp"
    android:paddingTop="@dimen/_8sdp"
    android:paddingEnd="@dimen/_4sdp"
    android:paddingBottom="@dimen/_8sdp">

    <!-- Cracker Icon -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeRailCrackerIcon"
        android:layout_width="@dimen/_36sdp"
        android:layout_height="@dimen/_36sdp" />

    <!-- Cracker Name -->
    <TextView
        android:id="@+id/tvRailCrackerName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_4sdp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-black"
        android:gravity="center"
        android:maxLines="2"
        android:text="Sutli Bomb"
        android:textColor="@color/white"
        android:textSize="@dimen/_9ssp"
        android:textStyle="bold" />

    <!-- Current Level Badge -->
    <TextView
        android:id="@+id/tvRailLevelBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_3sdp"
        android:background="@drawable/bg_coin_capsule"
        android:fontFamily="sans-serif-black"
        android:paddingStart="@dimen/_6sdp"
        android:paddingTop="@dimen/_1sdp"
        android:paddingEnd="@dimen/_6sdp"
        android:paddingBottom="@dimen/_1sdp"
        android:text="L25/25"
        android:textColor="@color/gold_light"
        android:textSize="@dimen/_7ssp"
        android:textStyle="bold" />

</LinearLayout>
