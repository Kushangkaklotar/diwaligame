<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_diwali_night">

    <!-- 1. Top Bar Area -->
    <LinearLayout
        android:id="@+id/llTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="@dimen/_10sdp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Animated Garland Fairy Lights -->
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/composeFairyLights"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_16sdp" />

        <!-- Header Content Row -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/_16sdp"
            android:paddingTop="@dimen/_6sdp"
            android:paddingEnd="@dimen/_16sdp"
            android:paddingBottom="@dimen/_4sdp">

            <!-- Title & Subtitle Column -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvAppTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.04"
                        android:text="DHAMAKA"
                        android:textColor="@color/gold_yellow"
                        android:textSize="@dimen/_18ssp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_6sdp"
                        android:background="@drawable/bg_pill_dark"
                        android:paddingStart="@dimen/_6sdp"
                        android:paddingTop="@dimen/_1sdp"
                        android:paddingEnd="@dimen/_6sdp"
                        android:paddingBottom="@dimen/_1sdp"
                        android:text="FESTIVAL"
                        android:textColor="@color/festive_red"
                        android:textSize="@dimen/_8ssp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3D Fireworks Arcade"
                    android:textColor="#B3FFFFFF"
                    android:textSize="@dimen/_10ssp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Sound Toggle Button -->
            <ImageButton
                android:id="@+id/btnSoundToggle"
                android:layout_width="@dimen/_36sdp"
                android:layout_height="@dimen/_36sdp"
                android:layout_marginEnd="@dimen/_8sdp"
                android:background="@drawable/bg_circular_btn"
                android:contentDescription="Toggle Sound"
                android:padding="@dimen/_8sdp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_sound_on"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/llCoinContainer"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Coin Balance Capsule -->
            <LinearLayout
                android:id="@+id/llCoinContainer"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_36sdp"
                android:background="@drawable/bg_coin_capsule"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/_10sdp"
                android:paddingEnd="@dimen/_14sdp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:src="@drawable/ic_coin" />

                <TextView
                    android:id="@+id/tvCoinCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_6sdp"
                    android:fontFamily="sans-serif-black"
                    android:text="5000"
                    android:textColor="@color/gold_yellow"
                    android:textSize="@dimen/_14ssp"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>

    <!-- 2. Hero Section: Rangoli Altar & Cracker Heap -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeHeroCluster"
        android:layout_width="0dp"
        android:layout_height="@dimen/_220sdp"
        android:layout_marginStart="@dimen/_14sdp"
        android:layout_marginTop="@dimen/_6sdp"
        android:layout_marginEnd="@dimen/_14sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/llTopBar" />

    <!-- Active Stage Badge Pill -->
    <TextView
        android:id="@+id/tvActiveStageBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_6sdp"
        android:background="@drawable/bg_pill_dark"
        android:drawablePadding="@dimen/_6sdp"
        android:paddingStart="@dimen/_16sdp"
        android:paddingTop="@dimen/_5sdp"
        android:paddingEnd="@dimen/_16sdp"
        android:paddingBottom="@dimen/_5sdp"
        android:text="SUTLI BOMB • STAGE 25/25  TAP TO BLAST ▶"
        android:textColor="@color/gold_light"
        android:textSize="@dimen/_11ssp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/composeHeroCluster" />

    <!-- 3. Primary Action: START BLASTING! 3D Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnStartBlasting"
        android:layout_width="0dp"
        android:layout_height="@dimen/_50sdp"
        android:layout_marginStart="@dimen/_16sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_marginEnd="@dimen/_16sdp"
        android:background="@drawable/bg_btn_start_blasting"
        android:drawableStart="@drawable/ic_flame"
        android:drawablePadding="@dimen/_8sdp"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.04"
        android:paddingStart="@dimen/_24sdp"
        android:paddingEnd="@dimen/_24sdp"
        android:text="START BLASTING!"
        android:textAllCaps="true"
        android:textColor="@color/white"
        android:textSize="@dimen/_16ssp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvActiveStageBadge" />

    <!-- 4. Secondary Action: 25 STAGES ROADMAP Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnLevelsRoadmap"
        android:layout_width="0dp"
        android:layout_height="@dimen/_44sdp"
        android:layout_marginStart="@dimen/_16sdp"
        android:layout_marginTop="@dimen/_8sdp"
        android:layout_marginEnd="@dimen/_16sdp"
        android:background="@drawable/bg_btn_levels"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.03"
        android:paddingStart="@dimen/_20sdp"
        android:paddingEnd="@dimen/_20sdp"
        android:text="25 STAGES ROADMAP   VIEW ALL ▶"
        android:textAllCaps="true"
        android:textColor="@color/gold_light"
        android:textSize="@dimen/_12ssp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnStartBlasting" />

    <!-- 5. Bottom Shelf: Cracker Packaging Cards Horizontal RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCrackerShelf"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/_10sdp"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:paddingStart="@dimen/_12sdp"
        android:paddingEnd="@dimen/_12sdp"
        android:paddingBottom="@dimen/_12sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnLevelsRoadmap" />

</androidx.constraintlayout.widget.ConstraintLayout>
